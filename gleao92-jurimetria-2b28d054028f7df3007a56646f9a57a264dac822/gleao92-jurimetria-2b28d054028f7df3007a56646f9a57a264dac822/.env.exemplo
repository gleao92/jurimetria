# Copie para .env e preencha. NUNCA versione o .env.

# Domínio que aponta para a VPS (o Caddy emite o certificado TLS sozinho)
DOMINIO=tempestivo.seudominio.com.br

# Banco. Deixe VAZIO para usar SQLite no volume persistente.
# Para Postgres gerenciado (Neon/Supabase/RDS) ou o container local:
# DATABASE_URL=postgresql://usuario:senha@host:5432/tempestivo
DATABASE_URL=

# Se usar o container postgres do compose:
# POSTGRES_PASSWORD=troque-esta-senha

# Chave da API para a classificação por IA (opcional)
# ANTHROPIC_API_KEY=
