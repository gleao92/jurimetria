{
  "entities": {
    "Processo": {
      "title": "Processo",
      "description": "Informações do processo judicial",
      "type": "object",
      "properties": {
        "numero": { "type": "string", "maxLength": 100 },
        "cliente": { "type": "string", "maxLength": 200 },
        "area": { "type": "string", "enum": ["civel", "criminal", "a_confirmar"] },
        "sistema": { "type": "string", "maxLength": 100 },
        "tribunal": { "type": "string", "maxLength": 100 },
        "assunto": { "type": "string", "maxLength": 300 }
      },
      "required": ["numero", "cliente", "area"]
    },
    "Prazo": {
      "title": "Prazo",
      "description": "Registro de prazo processual com contagem e vencimentos",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "publicacao_id": { "type": "string", "maxLength": 128 },
        "processo": { "type": "string", "maxLength": 100 },
        "cliente": { "type": "string", "maxLength": 200 },
        "tribunal": { "type": "string", "maxLength": 100 },
        "orgao": { "type": "string", "maxLength": 200 },
        "ato": { "type": "string", "maxLength": 200 },
        "area": { "type": "string", "enum": ["civel", "criminal", "a_confirmar"] },
        "data_disponibilizacao": { "type": "string", "maxLength": 20 },
        "publicacao": { "type": "string", "maxLength": 20 },
        "inicio_contagem": { "type": "string", "maxLength": 20 },
        "data_fatal": { "type": "string", "maxLength": 20 },
        "prazo_interno": { "type": "string", "maxLength": 20 },
        "dias_prazo": { "type": "number" },
        "status": { "type": "string", "enum": ["pendente_revisao", "confirmado", "cumprido"] },
        "confirmado_por": { "type": "string", "maxLength": 200 },
        "confirmado_em": { "type": "string", "maxLength": 50 },
        "cumprido_por": { "type": "string", "maxLength": 200 },
        "cumprido_em": { "type": "string", "maxLength": 50 },
        "observacoes": { "type": "string", "maxLength": 2000 },
        "teor": { "type": "string", "maxLength": 10000 },
        "contagem_explicacao": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "processo", "data_fatal", "status"]
    },
    "Compromisso": {
      "title": "Compromisso",
      "description": "Compromisso na agenda judicial ou extrajudicial",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "titulo": { "type": "string", "maxLength": 200 },
        "tipo": { "type": "string", "enum": ["audiencia", "reuniao", "diligencia", "outro"] },
        "data": { "type": "string", "maxLength": 20 },
        "hora": { "type": "string", "maxLength": 10 },
        "local": { "type": "string", "maxLength": 300 },
        "processo": { "type": "string", "maxLength": 100 },
        "cliente": { "type": "string", "maxLength": 200 },
        "observacoes": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "titulo", "tipo", "data"]
    },
    "Regra": {
      "title": "Regra",
      "description": "Regra de classificação automática de intimações",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "padrao": { "type": "string", "maxLength": 200 },
        "rotulo": { "type": "string", "maxLength": 200 },
        "dias": { "type": "number" },
        "ativa": { "type": "boolean" }
      },
      "required": ["id", "padrao", "rotulo", "ativa"]
    },
    "FeriadoLocal": {
      "title": "FeriadoLocal",
      "description": "Registro de feriado ou suspensão local de prazos",
      "type": "object",
      "properties": {
        "data": { "type": "string", "maxLength": 20 },
        "nome": { "type": "string", "maxLength": 200 }
      },
      "required": ["data", "nome"]
    },
    "Configuracao": {
      "title": "Configuracao",
      "description": "Configurações gerais do sistema e conexões OAB/MNI/DJEN",
      "type": "object",
      "properties": {
        "oab_numero": { "type": "string", "maxLength": 50 },
        "oab_uf": { "type": "string", "maxLength": 10 },
        "fonte": { "type": "string", "enum": ["djen", "mni", "ambas"] },
        "conectada": { "type": "boolean" },
        "area_padrao": { "type": "string", "enum": ["conservadora", "civel", "criminal"] },
        "mni_usuario": { "type": "string", "maxLength": 100 },
        "mni_senha": { "type": "string", "maxLength": 100 },
        "mni_wsdl": { "type": "string", "maxLength": 500 }
      }
    },
    "LogEntry": {
      "title": "LogEntry",
      "description": "Registro de log de auditoria",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "quando": { "type": "string", "maxLength": 50 },
        "acao": { "type": "string", "maxLength": 100 },
        "quem": { "type": "string", "maxLength": 200 },
        "detalhe": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "quando", "acao", "quem"]
    }
  },
  "firestore": {
    "/processos/{processoId}": {
      "schema": { "$ref": "#/entities/Processo" },
      "description": "Coleção de processos judiciais"
    },
    "/prazos/{prazoId}": {
      "schema": { "$ref": "#/entities/Prazo" },
      "description": "Coleção de prazos judiciais"
    },
    "/compromissos/{compromissoId}": {
      "schema": { "$ref": "#/entities/Compromisso" },
      "description": "Coleção de compromissos da agenda"
    },
    "/regras/{regraId}": {
      "schema": { "$ref": "#/entities/Regra" },
      "description": "Coleção de regras de extração"
    },
    "/feriados/{feriadoId}": {
      "schema": { "$ref": "#/entities/FeriadoLocal" },
      "description": "Coleção de feriados locais"
    },
    "/configuracao/{configId}": {
      "schema": { "$ref": "#/entities/Configuracao" },
      "description": "Documentos de configuração do sistema"
    },
    "/logs/{logId}": {
      "schema": { "$ref": "#/entities/LogEntry" },
      "description": "Logs de auditoria e execução"
    }
  }
}
